local NoclipConnection
local OriginalCollision = {}
local LockedHumanoid
local OriginalWalkSpeed
local OriginalSizes = {}
local HitboxConnection

local function getCharacter()
    return LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
end

local function setNoclip(enabled)
    if enabled then
        if NoclipConnection then return end
        NoclipConnection = RunService.Stepped:Connect(function()
            local character = LocalPlayer.Character
            if not character then return end
            for _, part in ipairs(character:GetDescendants()) do
                if part:IsA("BasePart") then
                    if OriginalCollision[part] == nil then
                        OriginalCollision[part] = part.CanCollide
                    end
                    part.CanCollide = false
                end
            end
        end)
    else
        if NoclipConnection then
            NoclipConnection:Disconnect()
            NoclipConnection = nil
        end
        for part, canCollide in pairs(OriginalCollision) do
            if part and part.Parent then
                part.CanCollide = canCollide
            end
        end
        table.clear(OriginalCollision)
    end
end

local function setWalkingDisabled(disabled, humanoid)
    if disabled then
        if not humanoid then return end
        LockedHumanoid = humanoid
        OriginalWalkSpeed = humanoid.WalkSpeed
        humanoid.WalkSpeed = 0
    elseif LockedHumanoid and LockedHumanoid.Parent and OriginalWalkSpeed ~= nil then
        LockedHumanoid.WalkSpeed = OriginalWalkSpeed
        LockedHumanoid = nil
        OriginalWalkSpeed = nil
    end
end

local function teleportTo(pos)
    local char = getCharacter()
    local root = char:WaitForChild("HumanoidRootPart", 3)
    if root then
        root.CFrame = CFrame.new(pos)
    end
end

local function applyHitbox(char)
    if not char or char == LocalPlayer.Character then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    if not OriginalSizes[char] then
        OriginalSizes[char] = hrp.Size
    end

    hrp.Size = HitboxSize
    hrp.Transparency = HitboxTransparency
    hrp.Color = HitboxColor
    hrp.Material = Enum.Material.Neon
    hrp.CanCollide = false
end

local function restoreAllHitboxes()
    for char, originalSize in pairs(OriginalSizes) do
        if char and char.Parent then
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if hrp then
                hrp.Size = originalSize
                hrp.Transparency = 0
                hrp.Color = Color3.fromRGB(255, 255, 255)
                hrp.Material = Enum.Material.Plastic
            end
        end
    end
    table.clear(OriginalSizes)
end

