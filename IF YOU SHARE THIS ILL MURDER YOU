function LookupPlayerStats(Username)
    if not Username or Username == "" then return end

    MainFrame.Visible = true

    local TargetPlayer
    for _, plr in pairs(game.Players:GetPlayers()) do
        if plr.Name:lower() == Username:lower() or plr.DisplayName:lower() == Username:lower() then
            TargetPlayer = plr
            break
        end
    end

    if not TargetPlayer then
        DurabilityLabel.Text = "Durability: N/A"
        EnduranceLabel.Text = "Endurance: N/A"
        StrengthLabel.Text = "Strength: N/A"
        return
    end

    local StatsFolder = TargetPlayer:FindFirstChild("StatsFolder")
    if not StatsFolder then return end

    local Durability = StatsFolder:FindFirstChild("Durability")
    local Endurance = StatsFolder:FindFirstChild("Endurance")
    local Strength = StatsFolder:FindFirstChild("Strength")

    DurabilityLabel.Text = "Durability: " .. tostring(Durability and Durability.Value or "N/A")
    EnduranceLabel.Text = "Endurance: " .. tostring(Endurance and Endurance.Value or "N/A")
    StrengthLabel.Text = "Strength: " .. tostring(Strength and Strength.Value or "N/A")
end

